{
  "name": "beauty1010-landing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "qr": "node scripts/make-qr.mjs",
    "print": "node scripts/make-print.mjs",
    "test:qr": "node scripts/test-qr.mjs",
    "deploy": "npm run build && cd dist && touch .nojekyll && rm -rf .git && git init -q -b gh-pages && git add -A && git commit -q -m deploy && git push -f https://github.com/zwolfros-debug/beauty1010.git gh-pages && rm -rf .git"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^23.10.4",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
